# Server
PORT=3000
NODE_ENV=development
MAX_REQUEST_SIZE=100kb

# Postgres (development)
DB_HOST_DEVELOPMENT=postgres
DB_PORT_DEVELOPMENT=5432
DB_USERNAME_DEVELOPMENT=postgres
DB_PASSWORD_DEVELOPMENT=postgres
DB_DATABASE_DEVELOPMENT=skilio

# Postgres (production)
DB_HOST_PRODUCTION=
DB_PORT_PRODUCTION=
DB_USERNAME_PRODUCTION=
DB_PASSWORD_PRODUCTION=
DB_DATABASE_PRODUCTION=

# JWT
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ImageKit (optional)
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Kafka
KAFKA_BROKERS=kafka:9092


